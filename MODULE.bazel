module(
    name = "openconfig_gnoi",
)

bazel_dep(name = "gazelle", version = "0.37.0", repo_name = "bazel_gazelle")
bazel_dep(name = "googleapis", version = "0.0.0-20240326-1c8d509c5", repo_name = "com_google_googleapis")
bazel_dep(name = "grpc", version = "1.65.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "protobuf", version = "27.2", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_go", version = "0.48.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_proto", version = "6.0.2")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.0.0-alpha2")
bazel_dep(name = "openconfig_gnsi", version = "1.6.0")
bazel_dep(name = "openconfig_gnmi", version = "0.11.0")
bazel_dep(name = "openconfig_bootz", version = "0.3.1")

# grpc-java is only included to fix "bazel mod graph".
bazel_dep(name = "grpc-java", version = "1.64.0")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.5")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_golang_protobuf", "org_golang_google_genproto_googleapis_rpc", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf")

switched_rules = use_extension("@com_google_googleapis//:extensions.bzl", "switched_rules")
switched_rules.use_languages(
    cc = True,
    go = True,
    grpc = True,
)
use_repo(switched_rules, "com_google_googleapis_imports")

go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/h-fam/errdiff",
)

# https://github.com/bazelbuild/bazel-gazelle/pull/1802 required for clean
# build_file_generation
git_override(
    module_name = "gazelle",
    commit = "7d10bf7befce477f518056cfc502939000bea3fa",
    remote = "https://github.com/bazelbuild/bazel-gazelle",
)

git_override(
    module_name = "openconfig_gnmi",
    commit = "a1403286fbeefb5d87152b48f4102d6507a8576b",
    remote = "https://github.com/bstoll/gnmi",
)

git_override(
    module_name = "openconfig_gnsi",
    commit = "a6199a88de259f7bfe842ff511a34a7904dbddb6",
    remote = "https://github.com/bstoll/gnsi",
)

git_override(
    module_name = "openconfig_bootz",
    commit = "d3aa4d52031fe4aa782e707b9c452ff72e179589",
    remote = "https://github.com/bstoll/bootz",
)
